################################################################
# Deploy gameplay_state only
################################################################

addon "svm" {
    rpc_api_url = input.rpc_api_url
    network_id = input.network_id
}

action "deploy_gameplay_state" "svm::deploy_program" {
    description = "Deploy gameplay_state program"
    program = svm::get_program_from_anchor_project("gameplay_state")
    authority = signer.authority
    payer = signer.payer
}
