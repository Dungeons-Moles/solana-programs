################################################################
# Deploy nft_marketplace only
################################################################

addon "svm" {
    rpc_api_url = input.rpc_api_url
    network_id = input.network_id
}

action "deploy_nft_marketplace" "svm::deploy_program" {
    description = "Deploy nft_marketplace program"
    program = svm::get_program_from_anchor_project("nft_marketplace")
    authority = signer.authority
    payer = signer.payer
}
