################################################################
# Deploy session_manager only
################################################################

addon "svm" {
    rpc_api_url = input.rpc_api_url
    network_id = input.network_id
}

action "deploy_session_manager" "svm::deploy_program" {
    description = "Deploy session_manager program"
    program = svm::get_program_from_anchor_project("session_manager")
    authority = signer.authority
    payer = signer.payer
}
